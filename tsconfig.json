{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2020", "DOM"],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"noImplicitAny": false
	},
	"include": ["src"],
	"exclude": ["test", "examples", "dist", "node_modules"]
}
